{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.loop/gate.mjs\"", "timeout": 1200 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.loop/guard.mjs\"" }]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm install:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx playwright:*)",
      "Bash(node .loop/loop.mjs status)",
      "Bash(node .loop/loop.mjs check:*)"
    ],
    "deny": [
      "Bash(node .loop/loop.mjs approve:*)",
      "Bash(node .loop/loop.mjs advance:*)",
      "Bash(node .loop/loop.mjs resume:*)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)"
    ]
  }
}
